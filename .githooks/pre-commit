#!/bin/sh
#
# Pre-commit guard for the two lint checks.
#
# 1. A stray backtick inside a CSS template literal closes it early; the rest of
#    the stylesheet is then read as JavaScript and the bundle stops parsing. That
#    landed ten times in this repository, each time surfacing far from the cause.
# 2. The host half is plain ESM, parsed only when something imports it, so a file
#    nothing currently reaches stays broken unnoticed.
#
# The logic lives in scripts/ so both can also run on their own and as early steps
# of `npm test`; this hook only wires them up.
#
# Enabled with:  git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

# Nothing staged that a check looks at? Then there is nothing to catch.
staged=$(git diff --cached --name-only -- 'client*.js' 'src/*.js' 'src/**/*.js' 'index.js')
if [ -z "$staged" ]; then
  exit 0
fi

failed=0

if [ -f scripts/check-css-literals.mjs ] \
   && git diff --cached --name-only -- 'client*.js' | grep -q .; then
  if ! node scripts/check-css-literals.mjs; then
    echo "" >&2
    echo "commit aborted: describe CSS in prose instead of quoting it." >&2
    failed=1
  fi
fi

if [ -f scripts/check-host.mjs ]; then
  if ! node scripts/check-host.mjs; then
    echo "" >&2
    echo "commit aborted: fix the host half, or stage nothing from it if the change" >&2
    echo "was incomplete." >&2
    failed=1
  fi
fi

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "commit aborted. Fix the above, then commit again." >&2
  exit 1
fi

exit 0
