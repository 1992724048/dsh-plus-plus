{
  "name": "dsh-plus-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Plus Plus —— DeepSeek Harness 多功能增强插件。随包分发字体栈（JetBrains Mono + 鸿蒙），界面直角化，按功能分模块可扩展。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.*": "./client.*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "selftest": "node scripts/host-selftest.mjs",
    "probe:client": "node scripts/probe-client.mjs",
    "probe:install": "node scripts/probe-install.mjs",
    "check:selectors": "node scripts/check-composer-selectors.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "theme",
    "composer"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "harmonyos-sans-webfont-splitted": "^1.2.1"
  }
}
