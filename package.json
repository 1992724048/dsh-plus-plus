{
  "name": "dsh-plus-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Plus Plus —— DeepSeek Harness 多功能增强插件。当前提供随包分发的字体栈：JetBrains Mono 优先，鸿蒙字体兜底中文。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "selftest": "node scripts/host-selftest.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "theme"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "harmonyos-sans-webfont-splitted": "^1.2.1"
  }
}
